{
  "name": "teletext-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/viewer"
  ],
  "scripts": {
    "server": "cd packages/core && bun run server",
    "cli": "cd packages/core && bun run cli",
    "test": "cd packages/core && bun test",
    "build:core": "cd packages/core && bun run build",
    "build:viewer": "cd packages/viewer && bun run build",
    "build": "bun run build:core && bun run build:viewer"
  }
}
